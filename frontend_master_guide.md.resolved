## 7. Wallet Page (`app/wallet/page.tsx`)

Beautiful card for balance and depositing.

```tsx
'use client';
import { AppLayout } from '@/components/AppLayout';
import DepositCard from '@/components/DepositModal'; // From previous guide
import { useQuery } from '@tanstack/react-query';
import { useAccount } from 'wagmi';
import { useSocket } from '@/hooks/useSocket';

export default function WalletPage() {
  const { address } = useAccount();
  useSocket(); // Ensure real-time updates

  const { data: balance = 0 } = useQuery({
    queryKey: ['balance', address],
    queryFn: async () => {
      const res = await fetch(`http://localhost:3000/token/balance`, { 
         headers: { 'x-wallet-address': address! } 
      });
      return (await res.json()).balance;
    },
    enabled: !!address,
  });

  return (
    <AppLayout>
      <div className="p-4 md:p-8 flex flex-col items-center justify-center min-h-[80vh] gap-8">
         {/* Balance Card */}
         <div className="w-full max-w-md bg-gradient-to-br from-blue-600 to-purple-600 rounded-3xl p-8 text-white shadow-2xl transform hover:scale-105 transition">
            <span className="opacity-80 font-medium">Total Balance</span>
            <div className="text-5xl font-bold mt-2">{balance}</div>
            <div className="mt-1 opacity-80">TOKENS</div>
         </div>

         {/* Deposit Form */}
         <div className="w-full max-w-md">
            <h2 className="text-xl font-bold mb-4 text-slate-300">Top Up</h2>
            <DepositCard />
         </div>
      </div>
    </AppLayout>
  );
}
```
